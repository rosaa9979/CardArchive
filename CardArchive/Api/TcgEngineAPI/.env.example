# Copy this file to ".env" on the server and fill in real values.
# The .env file is git-ignored; this .example file is the tracked template.

# Secret used to sign/verify JWT auth tokens. Use a long random unique value.
JWT_SECRET=

# MongoDB credentials (leave blank if your Mongo has no auth enabled)
MONGO_USER=
MONGO_PASS=

# SMTP credentials (only needed if smtp_enabled is true in config.js)
SMTP_USER=
SMTP_PASSWORD=

# HTTPS cert paths (only needed if allow_https is true). Leave blank to use config defaults.
HTTPS_KEY=
HTTPS_CA=
HTTPS_CERT=
