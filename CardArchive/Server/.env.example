# Copy this file to ".env" (same folder) and fill in real values.
# The .env file is git-ignored; this .example file is the tracked template.
#
# Read by the Unity game server (ServerManager.LoadApiCredentials) to log in to the API.
# The run-server scripts load this file and export them before launching the server.
#
# Note: server addresses are NOT secret and live in NetworkData.asset (committed to git).
# Only the API credentials below need to stay out of git.

# API account the game server uses to log in to the TcgEngine API.
API_USERNAME=
API_PASSWORD=
